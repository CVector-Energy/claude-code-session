{
  "name": "claude-code-session",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action: resume a Claude Code session between CI runs on the same work item",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/restore.js src/save.js --bundle --platform=node --target=node24 --format=esm --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire as __ccsRequire}from'node:module';const require=__ccsRequire(import.meta.url);\"",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "esbuild": "0.27.2"
  },
  "type": "module"
}
